{
  "name": "paperboat",
  "private": true,
  "license": "GPL-3.0-only",
  "workspaces": [
    "apps/*",
    "engine/toolkit/src/*/*/web",
    "engine/toolkit/src/*/web",
    "engine/toolkit/*/*/web",
    "engine/toolkit/*/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @paperboat/web --",
    "build": "npm run build -w @paperboat/web && npm run build:cli && npm run build:launcher",
    "build:cli": "npm run build -w @paperboat/cli",
    "build:launcher": "npm run build -w @paperboat/launcher",
    "build:release": "npm exec -w @paperboat/web -- vite build && npm run bundle -w @paperboat/cli && npm run build:launcher",
    "cli": "./bin/paperboat",
    "typecheck": "npm run typecheck -w @paperboat/web && npm run typecheck -w @paperboat/cli && npm run typecheck -w @paperboat/launcher",
    "e2e": "npm run e2e -w @paperboat/web --",
    "station:scratchpad": "cmake --build engine/build --target paperboat-scratchpad && engine/build/scratchpad/paperboat-scratchpad",
    "station:thermostat": "./bin/paperboat run 01",
    "station:cart-pole": "./bin/paperboat run 02",
    "station:island": "./bin/paperboat run 03",
    "station:cocktail": "./bin/paperboat run 04",
    "station:rover": "./bin/paperboat run 05",
    "station:robot": "./bin/paperboat run 06",
    "station:cfd": "./bin/paperboat run 07",
    "station:air-hockey": "./bin/paperboat run 08",
    "station:synth": "./bin/paperboat run 09",
    "station:pantograph": "./bin/paperboat run 10",
    "smoke": "python3 protocol/smoke_test.py --port",
    "build:python": "cmake -S python -B python/build > /dev/null && cmake --build python/build",
    "golden": "npm run build:python --silent && python3 protocol/golden.py",
    "docs": "./scripts/build_docs.sh",
    "test:python": "npm run build:python --silent && python3 -m pytest -q python/tests",
    "gen:protocol": "python3 protocol/gen_ts.py",
    "verify": "./scripts/verify.sh"
  }
}
