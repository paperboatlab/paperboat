@PACKAGE_INIT@
# find_package(paperboat) gives paperboat::runtime: the runtime manager's API (include/paperboat).
find_package(nlohmann_json 3.11 QUIET)
if(NOT TARGET nlohmann_json::nlohmann_json)  # macOS: the package carries the header
  add_library(nlohmann_json::nlohmann_json INTERFACE IMPORTED)
  set_target_properties(nlohmann_json::nlohmann_json PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/paperboatTargets.cmake")
set_property(TARGET paperboat::runtime APPEND PROPERTY INTERFACE_LINK_LIBRARIES nlohmann_json::nlohmann_json)
check_required_components(paperboat)
